// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id                Int        @id @default(autoincrement())
  name              String
  startDate         DateTime
  status            String     @default("Ongoing")
  statusDate        DateTime?
  startingHeadcount Int        @default(1)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  timelines         Timeline[]
}

model Timeline {
  id              Int              @id @default(autoincrement())
  name            String
  description     String?
  isMain          Boolean          @default(true)
  branchName      String           @default("Main")
  branchCloseMode BranchCloseMode?
  projectId       Int
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  events          Event[]
  risks           Risk[]
  quarterlyCapacities QuarterlyCapacity[]
}

model Event {
  id                Int              @id @default(autoincrement())
  name              String
  date              DateTime
  description       String?
  type              EventType
  impactSentiment   ImpactSentiment  @default(NEUTRAL)
  resourceCount     Int?
  resourcesReturned Boolean          @default(false)
  conclusionType    ConclusionType?
  timelineId        Int
  timeline          Timeline         @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

model Risk {
  id         Int       @id @default(autoincrement())
  name       String
  startDate  DateTime
  endDate    DateTime?
  status     String    @default("Ongoing")
  severity   String
  types      String
  impact     String?
  timelineId Int
  timeline   Timeline  @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model QuarterlyCapacity {
  id                   Int          @id @default(autoincrement())
  timelineId           Int
  timeline             Timeline     @relation(fields: [timelineId], references: [id], onDelete: Cascade)
  fiscalYear           Int
  quarter              FiscalQuarter
  totalFte             Float        @default(0)
  platformFte          Float        @default(0)
  replacementFte       Float        @default(0)
  newFte               Float        @default(0)
  businessContinuityFte Float       @default(0)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([timelineId, fiscalYear, quarter])
}

enum FiscalQuarter {
  Q1
  Q2
  Q3
  Q4
}

enum BranchCloseMode {
  REMERGE
  CLOSE
}

enum EventType {
  DELIVERABLE
  PRIORITY_CHANGE
  STAFFING_CHANGE
  INITIATIVE
  KEY_DECISION
  IMPEDIMENT
  FINISHED
}

enum ConclusionType {
  PAUSED
  CANCELLED
  SUCCESSFUL
}

enum ImpactSentiment {
  POSITIVE
  NEGATIVE
  NEUTRAL
}
